{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "importHelpers": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "allowJs": true,
    "baseUrl": "./",
    "strict": true,
    "paths": {
      "@render/*": ["./src/renderer/*"],
      "@main/*": ["./src/electron/*"]
    },
    "typeRoots": ["./src/renderer/@types"],
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "noImplicitAny": false
  },
  "references": [{ "path": "./tsconfig.node.json" }],
  "include": [
    "src/**/*.d.ts",
    "@types/**/*.ts",
    //"src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.json",
    "src/dataserver/**/*.ts" ,
    "src/dataserver/*.ts"
  ],
  "exclude": ["node_modules", "dist", "buildfiles"]
}
