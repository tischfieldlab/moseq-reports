{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "node",
        "importHelpers": true,
        "jsx": "preserve",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "sourceMap": true,
        "allowJs": true,
        "baseUrl": ".",
        "strict": true,
        "paths": {
            "@render/*": ["src/renderer/*"],
            "@store/*": ["src/renderer/store/*"],
            "@api": ["src/renderer/api"],
            "@main/*": ["src/electron/*"]
        },
        "typeRoots": ["./src/renderer/@types"],
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "noImplicitAny": false,
        "downlevelIteration": true,
    },
    "references": [{ "path": "./tsconfig.node.json" }],
    "include": [
        "src/**/*.d.ts",
        "@types/**/*.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.vue",
        "src/**/*.json",
        "src/dataserver/**/*.ts" ,
        "src/dataserver/*.ts",
        "src/renderer/**/*.ts"
    ],
    "exclude": ["node_modules", "dist", "buildfiles"]
}
