{
  "name": "moseq-reports",
  "version": "2.1.1",
  "main": "dist/electron/main/index.js",
  "description": "Interactive interrogation of Moseq models",
  "author": {
    "name": "Jay A. Tischfield Lab",
    "email": "thackray@rutgers.edu"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/tischfieldlab/moseq-reports/issues"
  },
  "homepage": "https://github.com/tischfieldlab/moseq-reports",
  "documentation": "https://tischfieldlab.github.io/moseq-reports/",
  "private": true,
  "keywords": [
    "electron",
    "rollup",
    "vite",
    "vue3",
    "vue"
  ],
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344/"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && electron-builder --publish never",
    "build-release": "vue-tsc --noEmit && vite build && electron-builder --publish always",
    "preview": "vite preview",
    "version": "cat package.json | grep version | head -1 | awk -F: '{ print $2 }' | sed 's/[\", ]//g'",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@electron/notarize": "^3.0.1",
